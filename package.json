{
  "name": "lykiva",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @lykiva/mobile",
    "web": "npm run dev --workspace @lykiva/web",
    "web:build": "npm run build --workspace @lykiva/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
