{
  "name": "lykiva",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @lykiva/mobile",
    "web": "npm run dev --workspace @lykiva/web",
    "web:build": "npm run build --workspace @lykiva/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:sql": "node supabase/test/dene.mjs"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-postgis": "^0.2.16"
  }
}
