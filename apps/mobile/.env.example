# Bu dosyayı ".env" adıyla kopyala ve değerleri doldur.

# Sunucu (Supabase). Anon anahtarı: Coolify > lykiva-supabase > Environment Variables > SERVICE_SUPABASEANON_KEY
# (anon anahtarı herkese açık olacak şekilde tasarlanmıştır; veriyi veritabanı kuralları korur)
EXPO_PUBLIC_SUPABASE_URL=https://api.lykiva.app
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# "Apple ile giriş" ücretli Apple Developer hesabı ister. Ücretsiz hesapla telefona derliyorsan aşağıdaki satırı aç.
# EXPO_PUBLIC_APPLE_GIRIS=0

# Harita stili (isteğe bağlı). Satır kapalıysa OpenFreeMap Liberty kullanılır (anahtarsız, OSM).
# Outdoor/topo stil için örnek: https://api.maptiler.com/maps/outdoor-v2/style.json?key=ANAHTAR
# EXPO_PUBLIC_MAP_STYLE_URL=
# Web sitesi (paylaşım bağlantıları bu adresle oluşur)
# EXPO_PUBLIC_WEB_URL=https://lykiva.app

# Rota çizme ve yer arama sunucuları (boşsa herkese açık brouter.de ve photon.komoot.io).
# Kendi sunucumuz kurulunca (altyapi/README.md):
# EXPO_PUBLIC_BROUTER_URL=https://brouter.lykiva.app/brouter
# EXPO_PUBLIC_PHOTON_URL=https://photon.lykiva.app/api/

# Hava durumu (boşsa api.met.no)
# EXPO_PUBLIC_HAVA_URL=
