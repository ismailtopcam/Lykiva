{
  "expo": {
    "name": "Lykiva",
    "slug": "lykiva",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lykiva",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2EDE3",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.lykiva.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      },
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.lykiva.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F2EDE3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lykiva, rotanı, hızını ve mesafeni kaydetmek için konumunu kullanır.",
          "locationAlwaysAndWhenInUsePermission": "Lykiva, ekran kapalıyken ya da başka bir uygulamaya geçtiğinde de rotanı kaydetmeye devam edebilmek için konumunu kullanır.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2EDE3",
          "image": "./assets/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#B04E25"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lykiva, profil fotoğrafını ve mola fotoğraflarını seçebilmen için fotoğraflarına erişir.",
          "cameraPermission": "Lykiva, profil ya da mola fotoğrafı çekebilmen için kamerayı kullanır.",
          "microphonePermission": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.lykiva.mobile.ExpoWidgetsTarget",
          "groupIdentifier": "group.app.lykiva.mobile"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c063d1da-06aa-4ab1-9868-ac9592eccb79"
      }
    },
    "owner": "ismailtopcam"
  }
}
